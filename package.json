{
    "name": "@ostro/vite",
    "version": "2.0.0-alpha.4",
    "type": "module",
    "description": "OstroJS plugin for Vite.",
    "keywords": [
        "ostro",
        "ostrojs",
        "vite",
        "vite-plugin"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/ostro-vite.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/ostro-vite/issues"
    },
    "homepage": "https://github.com/ostrojs/ostro-vite#readme",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./federation": {
            "types": "./dist/federation.d.ts",
            "default": "./dist/federation.js"
        }
    },
    "files": [
        "/dist"
    ],
    "bin": {
        "clean-orphaned-assets": "bin/clean.js"
    },
    "scripts": {
        "build": "npm run lint:check && rm -rf dist && tsc && cp src/dev-server-index.html dist/",
        "prepublishOnly": "npm run build",
        "test": "jest",
        "clean": "rm -rf dist coverage",
        "lint:check": "tsc --noEmit"
    },
    "peerDependencies": {
        "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
    },
    "dependencies": {
        "picocolors": "^1.1.1",
        "vite-plugin-full-reload": "^1.2.0"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^22.0.0",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.0",
        "vite": "^6.2.0"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "engineStrict": true
}
